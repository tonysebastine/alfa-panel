[Unit]
Description=ALFA-PANEL API
After=alfa-panel-agent.service
Requires=alfa-panel-agent.service

[Service]
Type=simple
User=alfa-panel
Group=alfa-panel
SupplementaryGroups=alfa-panel-agent
EnvironmentFile=/etc/alfa-panel/api.env
Environment=PANEL_AGENT_SOCKET=/run/alfa-panel/agent.sock
ExecStart=/opt/alfa-panel/bin/panel-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/panel/data /opt/panel/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

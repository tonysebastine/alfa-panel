# Existing AI Studio runtime settings
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ALFA Panel production secrets. Never commit real values.
PANEL_JWT_SECRET=replace-with-at-least-32-random-bytes
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD_BCRYPT=replace-with-bcrypt-hash
PANEL_TOTP_SECRET=replace-with-base32-totp-secret
PANEL_TRUST_PROXY=false

# Durable control-plane data store
PANEL_DATA_DIR=/opt/panel/data
PANEL_STORE_PATH=/opt/panel/data/panel.db
PANEL_MASTER_KEY=
PANEL_PROXY_CONTAINER=1panel-openresty
PANEL_AGENT_SOCKET=/run/alfa-panel/agent.sock
PANEL_API_LISTEN=127.0.0.1:8088
NEXT_PUBLIC_API_BASE_URL=
PANEL_TRUST_PROXY=false
PANEL_TRUSTED_PROXY_CIDRS=
PANEL_CORS_ORIGINS=https://panel.example.com
PANEL_REQUIRE_IMAGE_DIGEST=false
PANEL_ACME_WEBROOT=/opt/panel/acme
PANEL_ACME_SSLROOT=/opt/panel/apps/openresty/ssl
